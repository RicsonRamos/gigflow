# ==========================================
# CONFIGURAÇÕES DE AMBIENTE - FREELANCE COPILOT
# Copie este arquivo para .env e preencha com suas chaves gratuitas
# ==========================================

# 1. Telegram Bot (100% Gratuito - Criado via @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Notion API (100% Gratuito - Criado em notion.so/my-integrations)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# 3. Google Gemini API (100% Gratuito - Obter no Google AI Studio / aistudio.google.com)
GEMINI_API_KEY=

# 4. Modos de Execução e Automação
SIMULATE_DRY_RUN=false
AUTO_SUBMIT_PROPOSALS=true
AUTO_SUBMIT_MIN_SCORE=75
MAX_DAILY_PROPOSALS=10
SCRAPE_INTERVAL_MINUTES=15

# 5. Expansão Internacional
ENABLE_INTERNATIONAL=true
INTERNATIONAL_KEYWORDS=python,data,scraping,automation,fastapi,streamlit,etl,sql
MIN_BUDGET_USD=80
HOURLY_RATE_USD=35
